LIB CONNECT TO 'Dremio_Shop';

Orders:
LOAD OrderID, Customer, Qty, Price;
SQL SELECT OrderID, Customer, Qty, Price FROM "shop"."raw"."orders";

CustomerTotals:
LOAD Customer, Sum(Qty) AS TotalQty, Count(OrderID) AS Orders, Max(Price) AS MaxPrice
RESIDENT Orders GROUP BY Customer;

DROP TABLE Orders;
STORE CustomerTotals INTO [lib://QVD/CustomerTotals.qvd] (qvd);
