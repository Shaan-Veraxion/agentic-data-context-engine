# Copy to .env and change for anything beyond local development. Values here are local defaults only.
PG_USER=adce
PG_PASSWORD=adce
PG_PORT=5433
NEO4J_PASSWORD=adce-neo4j-pass
NEO4J_BOLT_PORT=7687
S3_ACCESS_KEY=adce
S3_SECRET_KEY=adce-s3-pass
S3_PORT=8333

# Application settings (read by adce_core.settings)
ADCE_PG_DSN=postgresql://adce:adce@localhost:5433/adce
ADCE_NEO4J_URI=bolt://localhost:7687
ADCE_NEO4J_USER=neo4j
ADCE_NEO4J_PASSWORD=adce-neo4j-pass
ADCE_S3_ENDPOINT=http://localhost:8333
ADCE_S3_ACCESS_KEY=adce
ADCE_S3_SECRET_KEY=adce-s3-pass
ADCE_S3_BUCKET=adce
GRAPHITI_TELEMETRY_ENABLED=false

# Model access (Google Cloud Vertex AI). Leave unset to run the gateway in replay mode.
# ADCE_VERTEX_PROJECT=
# ADCE_VERTEX_REGION=
ADCE_GATEWAY_MODE=replay

# Langfuse (obs profile)
LANGFUSE_PUBLIC_KEY=pk-lf-adce-local
LANGFUSE_SECRET_KEY=sk-lf-adce-local
LANGFUSE_HOST=http://localhost:3000

# the client this installation's knowledge belongs to (the knowledge service refuses to start without it);
# 'default' is the tenant of rows written before tenants existed (migration 0005)
ADCE_TENANT=default
